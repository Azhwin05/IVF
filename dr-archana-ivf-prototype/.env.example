# Frontend environment — copy to .env.local and adjust if needed.
#
#   cp .env.example .env.local
#
# This file is only needed if your backend is not on the default
# localhost:8600. The code in lib/api/client.ts already falls back to
# http://localhost:8600/api/v1 when this is unset, so a standard local
# setup works without creating .env.local at all.
#
# Note the variable name: NEXT_PUBLIC_API_URL (not ..._API_BASE_URL).
# It must include the /api/v1 suffix.
NEXT_PUBLIC_API_URL=http://localhost:8600/api/v1
